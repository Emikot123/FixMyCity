# PostgreSQL example:
# DB_URL=postgresql+psycopg://postgres:password@localhost:5432/fixmycity
# If DB_URL is omitted, the backend uses ./fixmycity.db (SQLite).
DB_URL=

MY_EMAIL=you@example.com
PASSWORD=your_email_app_password
HOST=smtp.example.com
PORT=587

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
MAX_VIDEO_MB=150
